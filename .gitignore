# Only the listed project paths are shared; anything else in a local checkout stays local.
/*
!/.gitignore
!/.githooks/
!/README.md
!/LICENSE
!/CITATION.cff
!/.zenodo.json
!/run_analysis.R
!/renv.lock
!/whole_tree_flux.Rproj
!/data/
!/flux/
!/scaling/
!/figures/
!/docs/
!/scripts/
!/tests/

# Third-party soil data: download instructions only
/data/soil_jevon2023/*
!/data/soil_jevon2023/README.md

# Regenerated locally: fitted-model cache, per-run provenance, optional illustration alternatives
/flux/cache/
/scaling/out/run_inputs.csv
/scaling/out/run_metadata.txt
/scaling/out/flux_uncertainty/sessionInfo.txt
/scaling/tree_illustrations/presentations/
/scaling/tree_illustrations/si_candidates/
/scaling/tree_illustrations/figure1_options/

# Local files
*manuscript*
*.docx
*.qmd
~$*
.DS_Store
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.Rprofile
renv/
Rplots.pdf
